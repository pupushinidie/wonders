{
  "name": "wonders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build:game": "npm run build -w @wonders/game",
    "test": "vitest run",
    "typecheck": "tsc -b && npm run typecheck -w @wonders/server && npm run typecheck -w @wonders/web",
    "predev": "npm run build:game",
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "start": "npm run build:game && npm run start -w @wonders/server",
    "dev:server": "npm run dev -w @wonders/server",
    "dev:web": "npm run dev -w @wonders/web",
    "build": "npm run build:game && npm run build -w @wonders/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
